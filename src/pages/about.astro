---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { aboutTimeline, partnerInstitutions } from '../data/site';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="About"
  description="About Reese Hollister: a Fulbright researcher and educator working across student support, educational programs, international research, and public communication."
  image="/assets/fieldwork/og/og-about.jpg"
>
  <section class="page-hero site-shell">
    <div class="about-hero__layout">
      <div class="about-hero__copy">
        <p class="section-kicker">About</p>
        <h1>About Reese Hollister</h1>
        <p class="page-lead">
          I’m Reese Hollister, a researcher, educator, and writing consultant based in Bucks County, Pennsylvania. I organize complex information, support students and programs, and develop work that people can read, watch, learn from, and use.
        </p>
        <p>
          My experience includes university course support and writing consultation at NC State, history teaching in Rabat, and co-developing Huruf La’b. I completed my Master of International Studies at NC State in May 2026. North Africa, Arabic, and my Fulbright year in Morocco remain central to how I research, teach, and communicate across contexts.
        </p>
      </div>
      <div class="about-hero__media">
        <figure class="about-inline-figure">
          <img
            class="about-portrait"
            src={withBase('/assets/fieldwork/cards/reese-aui-portrait-4x5.webp')}
            alt="Reese Hollister outside Al Akhawayn University in Ifrane, Morocco."
          />
          <figcaption class="about-portrait__caption">Al Akhawayn University, Ifrane, Morocco — Fulbright research base, 2023–24.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="site-shell">
    <SectionHeading
      eyebrow="Background"
      title="Where the work comes from"
      intro="Research, language learning, and teaching have developed together."
    />
    <ol class="timeline-list">
      {aboutTimeline.map((item) => (
        <li>
          <span class="timeline-label">{item.period}</span>
          <p>{item.summary}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="site-shell"><p><a class="resource-link" href={withBase('/experience')}>See my professional experience →</a></p></section>

  <section class="site-shell about-partners-section">
    <SectionHeading
      eyebrow="Background"
      title="Where I’ve worked and learned"
      intro="Programs, universities, and organizations I have worked with as a researcher, teacher, and scholar."
    />
    <ul class="partners-strip">
      {partnerInstitutions.map((inst) => (
        <li class="partner-item">
          <a href={inst.href} target="_blank" rel="noreferrer" class="partner-link" aria-label={inst.name}>
            <span class="partner-wordmark">
              <span class="partner-wordmark__name">{inst.wordmark}</span>
              <span class="partner-wordmark__sub">{inst.wordmarkSub}</span>
            </span>
          </a>
          <p class="partner-role">{inst.role}</p>
          <p class="partner-period">{inst.period}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="site-shell about-fieldwork-section">
    <SectionHeading
      eyebrow="Places & perspectives"
      title="Morocco, 2023–24"
      intro="Research and travel during the Fulbright year, with each place’s relationship made explicit."
    />
    <div class="about-fieldwork-grid">
      <figure>
        <img
          src={withBase('/assets/fieldwork/heroes/chefchaouen-blue-plaza-hero-16x9.webp')}
          alt="The blue medina of Chefchaouen, Morocco — narrow streets and blue-washed buildings."
          loading="lazy"
        />
        <figcaption>Travel · Chefchaouen.</figcaption>
      </figure>
      <figure>
        <img
          src={withBase('/assets/fieldwork/cards/mohammed-vi-library-aui-card-4x3.webp')}
          alt="Mohammed VI Library at Al Akhawayn University, Ifrane, Morocco — the archival research base."
          loading="lazy"
        />
        <figcaption>Research · Mohammed VI Library, Al Akhawayn University, Ifrane.</figcaption>
      </figure>
      <figure>
        <img
          src={withBase('/assets/fieldwork/heroes/merzouga-dunes-camels-hero-16x9.webp')}
          alt="The Sahara dunes near Merzouga, Morocco, with camels and desert landscape."
          loading="lazy"
        />
        <figcaption>Travel · Merzouga and the Erg Chebbi dunes.</figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>
