---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectFilters from '../components/ProjectFilters.astro';
import PDFEmbed from '../components/PDFEmbed.astro';
import ArtifactFigure from '../components/ArtifactFigure.astro';
import { works, workTypeLabels } from '../data/works';
import { mediaRecords } from '../data/editorial';
import { withBase } from '../utils/paths';
const formats = [...new Set(works.map(w => workTypeLabels[w.type]))];
---
<BaseLayout title="Works & Media" description="Browse Reese Hollister’s papers, slides, datasets, photographs, and project artifacts, with context and links to the work behind them.">
<section class="page-hero site-shell"><p class="section-kicker">The collection</p><h1>Read. Look closer. Explore.</h1><p class="page-lead">Papers, presentations, photographs, and research artifacts—with the context that connects them.</p><div class="action-list"><a class="button-secondary" href="#documents">Documents & data</a><a class="button-secondary" href="#media">Photos & artifacts</a><a class="resource-link" href={withBase('/writing')}>Published journal articles →</a><a class="resource-link" href={withBase('/youtube')}>Video library →</a></div></section>
<section class="site-shell" id="documents" data-catalog><p class="section-kicker">Documents & data</p><h2>The artifact index</h2><ProjectFilters categories={formats} noun="artifacts" categoryLabel="Type" />
<div class="artifact-index">{works.map(work => <article class="artifact-record" id={work.id} data-categories={workTypeLabels[work.type]} data-search={`${work.title} ${work.description} ${work.tags.join(' ')}`}><div><p class="section-kicker">{workTypeLabels[work.type]} · {work.year}</p><h3>{work.title}</h3><p>{work.description}</p><div class="action-list"><a class="resource-link" href={withBase(work.pdfPath)}>Open {work.type === 'dataset' ? 'data' : 'document'} ↗</a>{work.projectSlug && <a class="resource-link" href={withBase(`/projects/${work.projectSlug}`)}>Project & context →</a>}</div>{work.pdfPath.endsWith('.pdf') && <details class="artifact-reader"><summary>Read on this page</summary><PDFEmbed pdfPath={work.pdfPath} title={work.title} /></details>}</div></article>)}</div></section>
<section class="site-shell" id="media"><p class="section-kicker">Photos & artifacts</p><h2>A closer look at the work and the places.</h2><div class="media-collection">{mediaRecords.map(item => <article id={item.id}><ArtifactFigure src={item.image} alt={item.alt} caption={item.caption} eyebrow={item.type} /><h3>{item.title}</h3><div class="action-list">{'place' in item && item.place && <a class="resource-link" href={withBase(`/?place=${item.place}#atlas`)}>Place on the atlas →</a>}{'project' in item && item.project && <a class="resource-link" href={withBase(`/projects/${item.project}`)}>Project & context →</a>}</div></article>)}</div></section>
</BaseLayout>
