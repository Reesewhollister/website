---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { experienceGroups } from '../data/site';
import { withBase } from '../utils/paths';
---
<BaseLayout title="Experience" description="Reese Hollister’s experience in university course support, writing consultation, educational programs, international research, and public communication.">
  <section class="page-hero site-shell">
    <p class="section-kicker">Experience</p>
    <h1>Research. Teaching.<br />Work with people.</h1>
    <p class="page-lead">My work spans university courses, writing consultation, educational programs, international research, and public scholarship. Across those settings, I help people understand what comes next and make complex material usable.</p>
    <ul class="action-list"><li><a class="resource-link" href={withBase('/resume')}>CV / Resume overview</a></li><li><a class="resource-link" href={withBase('/contact')}>Professional contact</a></li></ul>
  </section>
  <section class="site-shell">
    <SectionHeading eyebrow="Selected experience" title="What I’ve done" intro="Organized by the work involved, with links to concrete examples." />
    <div class="experience-list">
      {experienceGroups.map(item => <article class="experience-entry"><div><p class="section-kicker">{item.org}</p><h3>{item.title}</h3><p class="experience-context">{item.context}</p></div><div><p>{item.summary}</p><ul>{item.bullets.map(bullet => <li>{bullet}</li>)}</ul><a class="resource-link" href={withBase(item.href)}>{item.cta} →</a></div></article>)}
    </div>
  </section>
  <section class="site-shell">
    <SectionHeading eyebrow="Education and credentials" title="A foundation in research and learning" />
    <ul><li>Master of International Studies, NC State University, 2026.</li><li>B.A. in History and Political Science, Manhattan College, 2023.</li><li>Fulbright research in Morocco, 2023–24.</li><li>CRLA Level III writing consultation certification.</li></ul>
    <p><a class="resource-link" href={withBase('/about')}>More about my background →</a></p>
  </section>
</BaseLayout>
