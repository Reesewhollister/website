---
import BaseLayout from '../layouts/BaseLayout.astro';
import { coachingServices, coachingInquiryUrl } from '../data/site';
import { withBase } from '../utils/paths';
---
<BaseLayout title="College Essay and Writing Coaching" description="Writing and college-essay coaching with Reese Hollister, a CRLA Level III writing consultant." image="/assets/fieldwork/og/og-coaching.jpg">
  <section class="page-hero site-shell">
    <p class="section-kicker">For students and families · Paid coaching</p>
    <h1>Your ideas. Your voice. A clearer draft.</h1>
    <p class="page-lead">I offer one-on-one support for college essays, research papers, and personal statements. My approach draws on CRLA Level III certification and writing consultation at NC State: understand the assignment, find the argument, and revise with purpose.</p>
    <div class="resume-request">
      <h2>Ask about coaching</h2>
      <p>Tell me what you are working on and when it is due. Use the contact form and choose <strong>College essay coaching</strong> as the topic.</p>
      <a class="button-primary" href={withBase(coachingInquiryUrl)} data-track="coaching_book_click">Start a conversation</a>
    </div>
    <ul class="coaching-services">
      {coachingServices.map((service) => (
        <li><h3>{service.title}</h3><p>{service.description}</p></li>
      ))}
    </ul>
    <p>This portfolio shows my professional experience, research, and educational projects. For employment or collaboration, use the same form and choose a different topic.</p>
  </section>
</BaseLayout>
