---
import BaseLayout from '../layouts/BaseLayout.astro';
import { coachingBookingUrl } from '../data/site';
import { withBase } from '../utils/paths';
---
<BaseLayout title="College Essay and Writing Coaching" description="Writing and college-essay coaching with Reese Hollister, a CRLA Level III writing consultant. Visit the separate coaching site for services and booking." image="/assets/fieldwork/og/og-coaching.jpg">
  <section class="page-hero site-shell">
    <p class="section-kicker">For students and families · Paid coaching</p>
    <h1>Your ideas. Your voice. A clearer draft.</h1>
    <p class="page-lead">I offer one-on-one support for college essays, research papers, and personal statements. My approach draws on CRLA Level III certification and writing consultation at NC State: understand the assignment, find the argument, and revise with purpose.</p>
    <div class="resume-request"><h2>Visit my coaching and booking site</h2><p>Services, testimonials, availability, and booking live on my separate Square site. That is the place to explore coaching and arrange a session.</p><a class="resource-link" href={coachingBookingUrl} data-track="coaching_book_click">College Essay Coaching ↗</a></div>
    <p>This portfolio shows my professional experience, research, and educational projects. For employment or collaboration, use <a href={withBase('/contact')}>professional contact</a>.</p>
  </section>
</BaseLayout>
