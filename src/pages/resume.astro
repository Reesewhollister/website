---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { experienceGroups, resumeRequestUrl, contactMethods } from '../data/site';
import { withBase } from '../utils/paths';
const linkedIn = contactMethods.find(item => item.label === 'LinkedIn')!;
---
<BaseLayout title="Resume" description="Reese Hollister’s professional summary, selected experience, credentials, and current resume request.">
  <section class="page-hero site-shell">
    <p class="section-kicker">Resume</p><h1>Experience that connects people and information.</h1>
    <p class="page-lead">Fulbright researcher and educator with experience in university course support, writing consultation, educational programs, international research, and public-facing projects. I bring careful organization, clear communication, and attention to the person using the work.</p>
    <div class="resume-request"><h2>Request my current resume</h2><p>For a current resume tailored to the role or project you have in mind, email me with a little context.</p><a class="resource-link" href={resumeRequestUrl}>Request current resume by email →</a></div>
    <ul class="action-list"><li><a class="resource-link" href={linkedIn.href}>LinkedIn ↗</a></li><li><a class="resource-link" href={withBase('/contact')}>Professional contact</a></li></ul>
  </section>
  <section class="site-shell">
    <SectionHeading eyebrow="Selected experience" title="Work at a glance" />
    <div class="resume-highlight-grid">{[experienceGroups[0],experienceGroups[1],experienceGroups[2],experienceGroups[4]].map(item => <article class="resume-card"><p class="section-kicker">{item.org}</p><h3>{item.title}</h3><p>{item.summary}</p><a class="resource-link" href={withBase(item.href)}>{item.cta} →</a></article>)}</div>
    <p><a class="resource-link" href={withBase('/experience')}>Read the full experience overview →</a></p>
  </section>
  <section class="site-shell"><SectionHeading eyebrow="Education and credentials" title="Selected credentials" /><ul><li>Master of International Studies, NC State University, 2026.</li><li>B.A. in History and Political Science, Manhattan College, 2023.</li><li>Fulbright Morocco, 2023–24.</li><li>CRLA Level III writing consultation certification.</li><li>Huruf La’b: $4,000 VenturePack award, NC State, 2026.</li></ul><p><a class="resource-link" href={withBase('/research')}>Research and academic work →</a></p></section>
</BaseLayout>
