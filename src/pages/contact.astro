---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { contactMethods } from '../data/site';
import { withBase, isExternal } from '../utils/paths';
---

<BaseLayout title="Contact" description="Contact Reese Hollister for program support, education, research, and public communication roles and projects.">
  <section class="page-hero site-shell">
    <p class="section-kicker">Contact</p>
    <h1>Start a conversation</h1>
    <p class="page-lead">
      For any reason: a job or professional opportunity, research or museum collaboration, university or
      teaching work, a speaking invitation, a project, or college essay coaching. Choose the closest topic
      and I will take it from there.
    </p>
  </section>

  <section class="site-shell">
    <div class="contact-layout">
      <div>
        <p class="section-kicker">Contact</p>
        <h2>Send a message</h2>
        <p>Prefer email? <a href="mailto:reesewhollister@gmail.com">reesewhollister@gmail.com</a></p>
        <p>Students and families: choose <strong>College essay coaching</strong> as the topic. Details about coaching are on the <a href={withBase('/coaching')}>coaching page</a>.</p>
      </div>
      <InquiryForm />
    </div>
  </section>

  <section class="site-shell">
    <SectionHeading
      eyebrow="Contact Methods"
      title="Contact methods"
      intro="Email, public profiles, and other active links."
    />
    <div class="contact-grid contact-grid--linear">
      {contactMethods.map((method) => (
        <article class="contact-card">
          <p class="section-kicker">{method.label}</p>
          <h3>
            {method.available ? (
              <a
                href={withBase(method.href)}
                target={isExternal(method.href) ? '_blank' : undefined}
                rel={isExternal(method.href) ? 'noreferrer' : undefined}
              >
                {method.value}
              </a>
            ) : (
              method.value
            )}
          </h3>
          <p>{method.note}</p>
          {method.available && (
            <div class="action-list">
              <a
                class="resource-link"
                href={withBase(method.href)}
                target={isExternal(method.href) ? '_blank' : undefined}
                rel={isExternal(method.href) ? 'noreferrer' : undefined}
              >
                {method.href.startsWith('mailto:') ? 'Send email' : 'Open profile'}
              </a>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
