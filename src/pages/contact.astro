---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { contactMethods, coachingBookingUrl } from '../data/site';
import { withBase, isExternal } from '../utils/paths';
---

<BaseLayout title="Contact" description="Contact Reese Hollister for program support, education, research, and public communication roles and projects.">
  <section class="page-hero site-shell">
    <p class="section-kicker">Contact</p>
    <h1>Contact</h1>
    <p class="page-lead">
      For employment, program support, research, educational work, or collaboration, email me with the role or project you have in mind.
    </p>
  </section>

  <section class="site-shell">
    <SectionHeading
      eyebrow="Contact Methods"
      title="Contact methods"
      intro="Email, public profiles, and other active links."
    />
    <div class="contact-grid contact-grid--linear">
      {contactMethods.map((method) => (
        <article class="contact-card">
          <p class="section-kicker">{method.label}</p>
          <h3>
            {method.available ? (
              <a
                href={withBase(method.href)}
                target={isExternal(method.href) ? '_blank' : undefined}
                rel={isExternal(method.href) ? 'noreferrer' : undefined}
              >
                {method.value}
              </a>
            ) : (
              method.value
            )}
          </h3>
          <p>{method.note}</p>
          {method.available && (
            <div class="action-list">
              <a
                class="resource-link"
                href={withBase(method.href)}
                target={isExternal(method.href) ? '_blank' : undefined}
                rel={isExternal(method.href) ? 'noreferrer' : undefined}
              >
                {method.href.startsWith('mailto:') ? 'Send email' : 'Open profile'}
              </a>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
  <section class="site-shell"><article class="contact-panel"><p class="section-kicker">Students and families</p><h2>Looking for paid writing coaching?</h2><p>Services, testimonials, availability, and booking are on my separate coaching site.</p><a class="resource-link" href={coachingBookingUrl}>College Essay Coaching ↗</a></article></section>
</BaseLayout>
