---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { heroThesis, homeIntro, proofStrip, capabilities, experienceGroups, coachingCta, contactCta, siteMeta, coachingBookingUrl } from '../data/site';
import { featuredProjects } from '../data/projects';
import { withBase } from '../utils/paths';
---
<BaseLayout title={siteMeta.title} description={siteMeta.description}>
  <section class="cinematic-hero professional-hero">
    <div class="cinematic-hero__media">
      <img src={withBase('/assets/fieldwork/heroes/chefchaouen-blue-plaza-hero-16x9.webp')} alt="" fetchpriority="high" />
    </div>
    <div class="cinematic-hero__inner site-shell">
      <p class="cinematic-hero__kicker">PROGRAM SUPPORT · RESEARCH · EDUCATION · PUBLIC ENGAGEMENT</p>
      <h1 class="cinematic-hero__title">{heroThesis}</h1>
      <p class="cinematic-hero__lead">{homeIntro}</p>
      <ul class="cinematic-hero__actions">
        <li><a href={withBase('/projects')}>View Selected Work</a></li>
        <li><a href={withBase('/experience')}>See My Experience</a></li>
        <li><a href={coachingBookingUrl}>College Essay Coaching ↗</a></li>
      </ul>
    </div>
    <span class="cinematic-hero__credit">Chefchaouen · Morocco fieldwork</span>
  </section>
  <section class="site-shell proof-strip-section" aria-label="Selected credentials">
    <ul class="proof-strip">
      {proofStrip.map((item) => <li class="proof-strip__item"><span class="proof-strip__label">{item.label}</span><span class="proof-strip__detail">{item.detail}</span></li>)}
    </ul>
    <div class="geo-strip" aria-hidden="true"><img src={withBase('/assets/ui/ornament/zellige-strip.svg')} alt="" width="340" height="32" /></div>
  </section>
  <section class="site-shell">
    <SectionHeading eyebrow="Capabilities" title="What I Bring" intro="I organize complex information, support people and programs, and turn research into useful public-facing work." />
    <div class="capability-grid">
      {capabilities.map((item, i) => <article class="capability-item"><span class="section-kicker" aria-hidden="true">0{i + 1}</span><h3>{item.title}</h3><p>{item.summary}</p><a class="resource-link" href={withBase(item.href)}>{item.cta} →</a></article>)}
    </div>
  </section>
  <section class="site-shell" id="selected-work">
    <SectionHeading eyebrow="Selected Work" title="Four ways the work takes shape" intro="Course support, an educational product, a research dataset, and public history. Each case study connects the work to its purpose and deliverables." />
    <div class="project-grid">{featuredProjects.map(project => <ProjectCard project={project} />)}</div>
    <p><a class="resource-link" href={withBase('/projects')}>Browse all projects and research →</a></p>
  </section>
  <section class="site-shell">
    <SectionHeading eyebrow="Experience" title="Supporting people, carrying work forward" />
    <div class="experience-preview">
      {experienceGroups.slice(0, 3).map(item => <article><p class="section-kicker">{item.org}</p><h3>{item.title}</h3><p>{item.summary}</p></article>)}
    </div>
    <p><a class="resource-link" href={withBase('/experience')}>See my experience →</a> <span aria-hidden="true"> · </span> <a class="resource-link" href={withBase('/resume')}>Resume and contact options →</a></p>
  </section>
  <section class="site-shell" aria-label="Contact and coaching">
    <div class="contact-split">
      {[contactCta, coachingCta].map(item => <article class="contact-panel"><p class="section-kicker">{item.eyebrow}</p><h2>{item.title}</h2><p>{item.body}</p><a class="resource-link" href={withBase(item.href)}>{item.cta}</a></article>)}
    </div>
  </section>
</BaseLayout>
