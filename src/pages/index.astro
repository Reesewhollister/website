---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapHero from '../components/MapHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { homeIntro, proofStrip, capabilities, experienceGroups, contactCta, siteMeta } from '../data/site';
import { featuredProjects } from '../data/projects';
import { withBase } from '../utils/paths';
---
<BaseLayout title={siteMeta.title} description={siteMeta.description}>
  <MapHero />
  <section class="credential-band" aria-label="Selected credentials">
    <ul class="credential-band__list site-shell">
      {proofStrip.map((item) => (
        <li class="credential">
          <svg class="credential__pin" viewBox="0 0 20 28" aria-hidden="true">
            <path d="M10,2 C5.6,2 2,5.6 2,10 C2,16.5 10,26 10,26 C10,26 18,16.5 18,10 C18,5.6 14.4,2 10,2 Z" />
            <circle cx="10" cy="10" r="3" />
          </svg>
          <span class="credential__label">{item.label}</span>
          <span class="credential__detail">{item.detail}</span>
        </li>
      ))}
    </ul>
  </section>
  <section class="site-shell">
    <SectionHeading eyebrow="Capabilities" title="What I Bring" intro={homeIntro} />
    <div class="capability-grid">
      {capabilities.map((item, i) => <article class="capability-item"><span class="section-kicker" aria-hidden="true">0{i + 1}</span><h3>{item.title}</h3><p>{item.summary}</p><a class="resource-link" href={withBase(item.href)}>{item.cta} →</a></article>)}
    </div>
  </section>
  <section class="site-shell" id="selected-work">
    <SectionHeading eyebrow="Selected Work" title="Four ways the work takes shape" intro="Course support, an educational product, a research dataset, and public history. Each case study connects the work to its purpose and deliverables." />
    <div class="work-stack">{featuredProjects.map(project => <ProjectCard project={project} wide />)}</div>
    <p><a class="resource-link" href={withBase('/projects')}>Browse all projects and research →</a></p>
  </section>
  <section class="site-shell">
    <SectionHeading eyebrow="Experience" title="Supporting people, carrying work forward" />
    <div class="experience-preview">
      {experienceGroups.slice(0, 3).map(item => <article><p class="section-kicker">{item.org}</p><h3>{item.title}</h3><p>{item.summary}</p></article>)}
    </div>
    <p><a class="resource-link" href={withBase('/experience')}>See my experience →</a> <span aria-hidden="true"> · </span> <a class="resource-link" href={withBase('/resume')}>Resume and contact options →</a></p>
  </section>
  <section class="site-shell" aria-label="Contact and coaching">
    <div class="contact-split">
      {[contactCta].map(item => <article class="contact-panel"><p class="section-kicker">{item.eyebrow}</p><h2>{item.title}</h2><p>{item.body}</p><a class="resource-link" href={withBase(item.href)}>{item.cta}</a></article>)}
    </div>
  </section>
</BaseLayout>
