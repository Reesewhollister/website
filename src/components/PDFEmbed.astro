---
import { withBase } from '../utils/paths';
interface Props { pdfPath: string; title: string; description?: string }
const { pdfPath, title, description } = Astro.props;
const href = withBase(pdfPath);
---
<div class="pdf-embed" data-pdf-reader>
<div class="pdf-embed__header"><div class="pdf-embed__meta"><span class="pdf-embed__label">PDF</span><span class="pdf-embed__title">{title}</span>{description && <p class="pdf-embed__desc">{description}</p>}</div><div class="pdf-embed__actions"><a class="pdf-embed__action" href={href} target="_blank" rel="noreferrer">Open in new tab</a><a class="pdf-embed__action" href={href} download>Download</a></div></div>
<button class="button-secondary pdf-load" type="button" data-pdf={href} data-title={title}>Load document preview</button><div class="pdf-embed__frame-wrap" data-pdf-frame hidden></div>
<noscript><p><a href={href}>Read {title}</a></p></noscript>
</div>
<script>
function setupPDFs() { document.querySelectorAll<HTMLButtonElement>('[data-pdf]').forEach(button => {
 if (button.dataset.wired) return; button.dataset.wired = 'true';
 button.addEventListener('click', () => { const frame = button.parentElement!.querySelector<HTMLElement>('[data-pdf-frame]')!; const iframe = document.createElement('iframe'); iframe.src = button.dataset.pdf!; iframe.title = `PDF preview: ${button.dataset.title}`; iframe.className = 'pdf-embed__frame'; frame.replaceChildren(iframe); frame.hidden = false; button.hidden = true; });
}); }
document.addEventListener('astro:page-load',setupPDFs); setupPDFs();
</script>
