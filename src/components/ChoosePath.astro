---
// Inline single-weight line icons (viewBox 0 0 32 32, stroke=currentColor).
// Colored via CSS in the page's current register — see .choose-path__icon.
const paths = [
  {
    label: 'Research Projects',
    href: '/projects',
    icon: '<rect x="6" y="5" width="16" height="22" rx="1.5"/><path d="M22 9 L26 11 L21 25 L17 23"/><line x1="9" y1="11" x2="18" y2="11"/><line x1="9" y1="15" x2="18" y2="15"/>',
    desc: 'Postcolonial Africa, Western Sahara, Morocco'
  },
  {
    label: 'Maps & Datasets',
    href: '/projects/from-colonies-to-carriers',
    icon: '<path d="M4 8 L12 5 L20 8 L28 5 L28 24 L20 27 L12 24 L4 27 Z"/><line x1="12" y1="5" x2="12" y2="24"/><line x1="20" y1="8" x2="20" y2="27"/>',
    desc: '723-airline encyclopedia, road time-series'
  },
  {
    label: 'Writing Coaching',
    href: '/coaching',
    icon: '<path d="M7 25 L7 21 L21 7 L25 11 L11 25 Z"/><line x1="19" y1="9" x2="23" y2="13"/><line x1="7" y1="25" x2="11" y2="25"/>',
    desc: 'Academic, graduate, personal statement'
  },
  {
    label: 'Teaching Work',
    href: '/teaching',
    icon: '<rect x="6" y="6" width="20" height="20" rx="2"/><path d="M16 11 L16 21 M16 11 Q13 11 13 14"/>',
    desc: "Arabic instruction, Huruf La'b, tutoring"
  },
  {
    label: 'Videos & Public Scholarship',
    href: '/writing',
    icon: '<rect x="5" y="8" width="22" height="16" rx="2"/><path d="M14 13 L19 16 L14 19 Z" fill="currentColor" stroke="none"/>',
    desc: 'YouTube, Substack, conference talks'
  },
  {
    label: 'CV & PDFs',
    href: '/works',
    icon: '<path d="M9 4 L19 4 L24 9 L24 28 L9 28 Z"/><path d="M19 4 L19 9 L24 9"/><line x1="13" y1="16" x2="20" y2="16"/><line x1="13" y1="20" x2="20" y2="20"/>',
    desc: 'Papers, decks, teaching materials'
  }
];
---

<section class="choose-path site-shell" aria-labelledby="choose-path-heading">
  <p id="choose-path-heading" class="section-kicker">What are you here to see?</p>
  <ul class="choose-path__grid" role="list">
    {paths.map((p) => (
      <li>
        <a
          class="choose-path__card"
          href={p.href}
          data-track="choose_path_click"
          data-track-label={p.label}
        >
          <span class="choose-path__icon" aria-hidden="true">
            <svg
              viewBox="0 0 32 32"
              width="28"
              height="28"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={p.icon}
            />
          </span>
          <span class="choose-path__label">{p.label}</span>
          <span class="choose-path__desc">{p.desc}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
