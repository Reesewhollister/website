---
import { navLinks, coachingBookingUrl } from '../data/site';
import { withBase, isExternal } from '../utils/paths';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="site-shell header-inner">
    <a class="brand-mark" href={withBase('/')}>
      <span class="brand-mark__name">Reese Hollister</span>
      <span class="brand-mark__tag">Research, education & public engagement</span>
    </a>
    <nav aria-label="Primary">
      <ul class="site-nav">
        {navLinks.map(link => {
          const href = withBase(link.href);
          const route = href.replace(/\/$/, '') || '/';
          const isActive = !isExternal(href) && (pathname === route || (link.href !== '/' && pathname.startsWith(route + '/')));
          return <li><a class:list={['site-nav__link', {'is-active': isActive, 'site-nav__link--coaching': link.href === coachingBookingUrl}]} href={href} aria-current={isActive ? 'page' : undefined}>{link.label}</a></li>;
        })}
      </ul>
    </nav>
  </div>
</header>
