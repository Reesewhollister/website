---
import type { Project } from '../data/projects';
import { withBase, isExternal } from '../utils/paths';
import ProjectCover from './ProjectCover.astro';

interface Props {
  project: Project;
  /** Use the Asset & Motion System cover frame (brass corners + zellige diamond). */
  framed?: boolean;
  /** Horizontal split — a large plate on the left, the writing on the right. */
  wide?: boolean;
}

const { project, framed = false, wide = false } = Astro.props;
const href = `/projects/${project.slug}`;
const heroSrc = withBase(project.heroAsset.src);
const card = project.card;
const cardTitle = card?.title ?? project.title;
const cardSummary = card?.summary ?? project.summary;
const accent = card?.accent ?? 'rust';
const materials = card?.materials ?? project.categories;
const deckHref = `${href}#deck`;
const secondaryAction = !project.deck ? card?.secondaryAction : undefined;
---

<article class={`project-card${framed ? ' project-card--framed' : ''}${wide ? ' project-card--wide' : ''}`} data-categories={[...project.categories, ...(project.tags ?? [])].join('|')} data-formats={[...(project.paper ? ['Paper'] : []), ...(project.deck ? ['Slides'] : []), ...((project.videos?.length || project.ytVideos?.length || project.tags?.includes('Video')) ? ['Video'] : []), ...(project.categories.includes('Product / Design') ? ['Product'] : [])].join('|')} data-accent={accent}>
  {framed ? (
    <ProjectCover
      src={project.heroAsset.src}
      alt={project.heroAsset.alt}
      href={href}
      showText={false}
      aspect="16 / 10"
    />
  ) : (
    <a class="project-card__media" href={withBase(href)}>
      <img src={heroSrc} alt={project.heroAsset.alt} loading="lazy" />
      {wide && (
        <svg class="project-card__brackets" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0,13 L0,0 L13,0" />
          <path d="M87,0 L100,0 L100,13" />
          <path d="M100,87 L100,100 L87,100" />
          <path d="M13,100 L0,100 L0,87" />
        </svg>
      )}
    </a>
  )}
  <div class="project-card__body">
    <h3>
      <a href={withBase(href)}>{cardTitle}</a>
    </h3>
    <p class="project-card__meta">{project.categories.join(' / ')}</p>
    <p>{cardSummary}</p>
    {materials.length > 0 && (
      <ul class="project-card__chips" aria-label={`${cardTitle} materials`}>
        {materials.map((material) => (
          <li>{material}</li>
        ))}
      </ul>
    )}
    <div class="project-card__actions">
      <a href={withBase(href)} aria-label={`View case study: ${cardTitle}`}>View case study</a>
      {project.deck ? (
        <a href={withBase(deckHref)} aria-label={`Open deck: ${cardTitle}`}>Open deck</a>
      ) : (
        secondaryAction && (
          <a
            href={withBase(secondaryAction.href)}
            target={isExternal(secondaryAction.href) ? '_blank' : undefined}
            rel={isExternal(secondaryAction.href) ? 'noreferrer' : undefined}
          >
            {secondaryAction.label}
          </a>
        )
      )}
    </div>
  </div>
</article>
