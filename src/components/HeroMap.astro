---
// Decorative route-fan backdrop for the home hero (Asset & Motion System).
// Ported from the prototype's _heroMap(): arcs fan from a hub, planes travel,
// the hub pulses, over a faint graticule. Purely ornamental (aria-hidden).
// Motion is CSS-driven + reduced-motion safe (resting state = fully drawn).
const VB = 760;
const cx = 300;
const cy = 360;
const dests: [number, number][] = [
  [120, 120], [470, 90], [560, 240], [520, 470], [180, 500], [60, 300], [420, 560]
];
const routes = dests.map((d, i) => {
  const mx = (cx + d[0]) / 2;
  const my = Math.min(cy, d[1]) - 90 - i * 10;
  const path = `M${cx} ${cy} Q${mx} ${my.toFixed(1)} ${d[0]} ${d[1]}`;
  const len = Math.round(Math.hypot(d[0] - cx, d[1] - cy) * 1.7);
  return { path, len, x: d[0], y: d[1], delay: (i * 0.28).toFixed(2) };
});
const gridV = Array.from({ length: 14 }, (_, i) => i * 60);
const gridH = Array.from({ length: 14 }, (_, i) => i * 60);
---
<svg
  class="hero-map"
  viewBox={`0 0 ${VB} ${VB}`}
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  {gridV.map((x) => (
    <path d={`M${x} 0 Q${x + 20} 380 ${x} 760`} stroke="var(--sys-brass)" stroke-width="0.4" opacity="0.08" />
  ))}
  {gridH.map((y) => (
    <line x1="0" y1={y} x2="760" y2={y} stroke="var(--sys-brass)" stroke-width="0.4" opacity="0.08" />
  ))}

  {routes.map((r) => (
    <path
      class="hero-map__arc"
      d={r.path}
      stroke="var(--sys-brass)"
      stroke-width="1.2"
      opacity="0.7"
      stroke-dasharray={r.len}
      style={`--dash:${r.len};animation-delay:${r.delay}s`}
    />
  ))}
  {routes.map((r) => (
    <circle cx={r.x} cy={r.y} r="3.4" fill="var(--sys-ember)" />
  ))}
  {routes.map((r) => (
    <path
      class="hero-map__plane"
      d="M4 0 L-3 -2.4 L-1 0 L-3 2.4 Z"
      fill="var(--sys-card)"
      style={`offset-path:path('${r.path}');animation-delay:${r.delay}s`}
    />
  ))}

  <circle cx={cx} cy={cy} r="7" fill="var(--sys-terracotta)" />
  <circle class="hero-map__pulse" cx={cx} cy={cy} r="13" stroke="var(--sys-terracotta)" stroke-width="1" fill="none" style={`transform-origin:${cx}px ${cy}px`} />
</svg>

<style>
  .hero-map { width: 100%; height: 100%; display: block; }
  .hero-map__arc { stroke-dashoffset: 0; }
  .hero-map__plane { opacity: 0; }
  .hero-map__pulse { opacity: 0; }
  @supports not (offset-path: path('M0 0 L1 1')) {
    .hero-map__plane { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-map__arc { animation: heroMapDraw 2.4s cubic-bezier(0.22, 0.61, 0.36, 1) both; }
    .hero-map__plane { opacity: 1; offset-rotate: auto; animation: heroMapPlane 3.6s linear infinite; }
    .hero-map__pulse { transform-box: fill-box; animation: heroMapPulse 3s ease-in-out infinite; }
    @keyframes heroMapDraw { from { stroke-dashoffset: var(--dash); } to { stroke-dashoffset: 0; } }
    @keyframes heroMapPlane { from { offset-distance: 0%; } to { offset-distance: 100%; } }
    @keyframes heroMapPulse { 0%, 100% { transform: scale(1); opacity: 0.55; } 50% { transform: scale(2); opacity: 0; } }
  }
</style>
