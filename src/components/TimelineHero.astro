---
import { aboutTimelineFull } from '../data/site';
import { withBase } from '../utils/paths';

// Newest first: the page reads from now backwards.
const chapters = [...aboutTimelineFull].reverse();
---

<section class="chrono site-shell" aria-labelledby="chrono-title">
  <div class="chrono__head">
    <p class="section-kicker">The path here</p>
    <h2 id="chrono-title">Now, working backwards.</h2>
  </div>

  <div class="chrono__rail-wrap">
    <ol class="chrono__rail" id="chrono-rail" style={`--count:${chapters.length}`}>
      {chapters.map((chapter, i) => (
        <li class="chrono__stop">
          <button
            type="button"
            class:list={['chrono__stop-btn', { 'is-active': i === 0 }]}
            data-step={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-controls={`chrono-panel-${chapter.id}`}
          >
            <span class="chrono__dot" aria-hidden="true"></span>
            <span class="chrono__year">{chapter.year}</span>
            <span class="chrono__short">{chapter.short}</span>
          </button>
        </li>
      ))}
    </ol>
  </div>

  <div class="chrono__controls">
    <button type="button" class="chrono__step" data-dir="-1" disabled>‹ Later</button>
    <p class="chrono__position"><span id="chrono-pos">1</span> / {chapters.length}</p>
    <button type="button" class="chrono__step" data-dir="1">Earlier ›</button>
  </div>

  <div class="chrono__panels" aria-live="polite">
    {chapters.map((chapter, i) => (
      <article
        class="chrono__panel"
        id={`chrono-panel-${chapter.id}`}
        data-chapter={chapter.id}
        hidden={i !== 0}
      >
        <p class="chrono__date">{chapter.date}</p>
        <h3 tabindex="-1">{chapter.period}</h3>
        <p class="chrono__summary">{chapter.summary}</p>
        <a class="resource-link" href={withBase(chapter.href)}>{chapter.cta} →</a>
      </article>
    ))}
  </div>
</section>

<script>
  function setupChrono() {
    const root = document.querySelector<HTMLElement>('.chrono');
    if (!root) return;
    const rail = root.querySelector<HTMLElement>('.chrono__rail');
    const stops = Array.from(root.querySelectorAll<HTMLButtonElement>('.chrono__stop-btn'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.chrono__panel'));
    const steppers = Array.from(root.querySelectorAll<HTMLButtonElement>('.chrono__step'));
    const position = root.querySelector<HTMLElement>('#chrono-pos');
    if (!rail || stops.length === 0) return;

    const behavior: ScrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ? 'auto'
      : 'smooth';
    const last = stops.length - 1;
    let active = 0;

    const render = (scroll: boolean, focusPanel: boolean) => {
      rail.style.setProperty('--fill', String(last > 0 ? active / last : 0));

      stops.forEach((stop, i) => {
        const on = i === active;
        stop.setAttribute('aria-pressed', String(on));
        stop.classList.toggle('is-active', on);
        if (on && scroll) stop.scrollIntoView({ inline: 'center', block: 'nearest', behavior });
      });

      panels.forEach((panel, i) => {
        panel.hidden = i !== active;
      });

      if (position) position.textContent = String(active + 1);

      for (const stepper of steppers) {
        stepper.disabled = Number(stepper.dataset.dir) < 0 ? active === 0 : active === last;
      }

      if (focusPanel) {
        panels[active]?.querySelector<HTMLElement>('h3')?.focus({ preventScroll: true });
      }
    };

    const go = (next: number, focusPanel = false) => {
      const clamped = Math.min(last, Math.max(0, next));
      if (clamped === active) return;
      active = clamped;
      render(true, focusPanel);
    };

    stops.forEach((stop, i) => stop.addEventListener('click', () => go(i)));

    for (const stepper of steppers) {
      stepper.addEventListener('click', () => go(active + Number(stepper.dataset.dir), true));
    }

    rail.addEventListener('keydown', (event) => {
      const keys = ['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Home', 'End'];
      if (!keys.includes(event.key)) return;
      event.preventDefault();
      const target =
        event.key === 'Home'
          ? 0
          : event.key === 'End'
            ? last
            : active + (event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : -1);
      go(target);
      stops[Math.min(last, Math.max(0, target))]?.focus({ preventScroll: true });
    });

    render(false, false);
  }

  document.addEventListener('astro:page-load', setupChrono);
</script>
