---
/**
 * Home hero: an atlas plate with a catalogue rail.
 *
 * The plate is projected at BUILD time with d3-geo — no map library, no tiles and
 * no runtime fetch ship to the browser. Only the small interaction script below
 * runs on the client. The place index is the canonical text alternative: every
 * fact reachable from the map is reachable from the list.
 */
import { geoEqualEarth, geoPath, geoGraticule } from 'd3-geo';
import { feature, merge, mesh } from 'topojson-client';
import worldAtlas from 'world-atlas/countries-110m.json';
import { PLACES, ALL_PLACES, JOURNEY, MAP } from '../data/places';
import { PAPERS, MAPPED_PAPERS, RESEARCH_REGIONS } from '../data/papers';
import { getProjectBySlug } from '../data/projects';
import { aboutTimelineFull } from '../data/site';

// Newest first: the chronology reads from now backwards, and each stop flies the
// plate to the place that chapter happened in.
const chapters = [...aboutTimelineFull].reverse();

import { withBase } from '../utils/paths';

const world = worldAtlas as any;
const geometries = world.objects.countries.geometries as any[];
const iso = (g: any) => String(g.id).padStart(3, '0');

/** Morocco is drawn once, as a single silhouette (504 + 732 merged, shared border omitted). */
const MOROCCO_IDS = new Set(['504', '732']);
const isMorocco = (g: any) => MOROCCO_IDS.has(iso(g));

/** Antarctica is never marked and only intrudes on the frame's lower edge. */
const ANTARCTICA = '010';
const isDrawn = (g: any) => iso(g) !== ANTARCTICA;

const AFRICA_IDS = new Set([
  '012','024','072','108','120','132','140','148','174','178','180','204','226','231','232','262','266','270',
  '288','324','384','404','426','430','434','450','454','466','478','480','504','508','516','562','566','624',
  '646','678','686','690','694','706','710','716','728','729','732','748','768','788','800','818','834','854','894'
]);

const { width: W, height: H, pad } = MAP;
const projection = geoEqualEarth()
  .rotate([14, 0])
  .fitExtent([[pad, pad], [W - pad, H - pad]], MAP.frame as any);
const path = geoPath(projection);

const land = path(
  feature(world, {
    type: 'GeometryCollection',
    geometries: geometries.filter((g) => !isMorocco(g) && isDrawn(g))
  } as any) as any
);
const morocco = path(merge(world, geometries.filter(isMorocco)) as any);
const borders = path(
  mesh(
    world,
    world.objects.countries,
    (a: any, b: any) => a !== b && !(isMorocco(a) && isMorocco(b)) && isDrawn(a) && isDrawn(b)
  )
);
const graticule = path(geoGraticule().step([20, 20])());

/**
 * Regions drawn as hatch. Country regions are merged out of the same topology as
 * the base map; a region that is not a country (the American West) is a rectangle.
 */
const rect = ([[lon0, lat0], [lon1, lat1]]: [[number, number], [number, number]]) => ({
  type: 'Polygon' as const,
  coordinates: [[[lon0, lat0], [lon0, lat1], [lon1, lat1], [lon1, lat0], [lon0, lat0]]]
});

const regionPath = (id: string) => {
  if (id === 'africa') return path(merge(world, geometries.filter((g) => AFRICA_IDS.has(iso(g)))) as any);
  if (id === 'western-sahara') return path(merge(world, geometries.filter((g) => iso(g) === '732')) as any);
  if (id === 'morocco') return path(merge(world, geometries.filter((g) => iso(g) === '504')) as any);
  const region = RESEARCH_REGIONS.find((r) => r.id === id);
  if (region?.iso) return path(merge(world, geometries.filter((g) => region.iso!.includes(iso(g)))) as any);
  if (region?.bbox) return path(rect(region.bbox) as any);
  return '';
};

const studyRegions = RESEARCH_REGIONS.map((region) => ({ region: region.id, d: regionPath(region.id) }));

/** Regions a published paper is set in stay lit; project regions still appear on demand. */
const paperRegions = new Set(MAPPED_PAPERS.map((paper) => paper.region));

const paperNodes = MAPPED_PAPERS.map((paper) => {
  const [x, y] = projection(paper.coords!)!;
  return { paper, left: (x / W) * 100, top: (y / H) * 100 };
});

const journey = path({
  type: 'LineString',
  coordinates: JOURNEY.map((id) => ALL_PLACES.find((p) => p.id === id)!.coords)
} as any);

/** Cluster zoom targets, precomputed in viewBox units. */
const zoomFor = (place: (typeof PLACES)[number]) => {
  if (!place.bbox) return null;
  const [[lon0, lat0], [lon1, lat1]] = place.bbox;
  const [[x0, y0], [x1, y1]] = path.bounds({
    type: 'Polygon',
    coordinates: [[[lon0, lat0], [lon0, lat1], [lon1, lat1], [lon1, lat0], [lon0, lat0]]]
  } as any);
  const k = Math.min(MAP.maxZoom, 0.8 * Math.min(W / (x1 - x0), H / (y1 - y0)));
  return { k, x: W / 2 - (k * (x0 + x1)) / 2, y: H / 2 - (k * (y0 + y1)) / 2 };
};

const nodes = ALL_PLACES.map((place) => {
  const [x, y] = projection(place.coords)!;
  const parent = PLACES.find((p) => p.children?.some((c) => c.id === place.id));
  const left = (x / W) * 100;
  return {
    place,
    parentId: parent?.id ?? null,
    left,
    top: (y / H) * 100,
    // A card centred on a pin near the plate edge would be clipped, so pins in
    // the outer thirds hang their card inward from one corner instead.
    cardSide: place.cardSide ?? (left > 68 ? 'right' : left < 26 ? 'left' : 'center'),
    zoom: zoomFor(place as any)
  };
});

/** 35.78° N · 78.64° W — the field-record readout under a selected place. */
const readCoords = ([lon, lat]: [number, number]) =>
  `${Math.abs(lat).toFixed(2)}° ${lat >= 0 ? 'N' : 'S'} · ${Math.abs(lon).toFixed(2)}° ${lon >= 0 ? 'E' : 'W'}`;

/** Dossier order: clusters and standalone places, then children. Matches the index. */
const navOrder = ALL_PLACES.map((p) => p.id);

const dossiers = ALL_PLACES.map((place) => {
  const i = navOrder.indexOf(place.id);
  const prev = ALL_PLACES[(i - 1 + navOrder.length) % navOrder.length];
  const next = ALL_PLACES[(i + 1) % navOrder.length];
  const projects = place.projects
    .map((link) => {
      const project = getProjectBySlug(link.slug);
      return project ? { ...link, title: project.title, href: `/projects/${project.slug}` } : null;
    })
    .filter((entry): entry is NonNullable<typeof entry> => entry !== null);
  return { place, prev, next, projects, coords: readCoords(place.coords) };
});

const layerFor = (kind: string) => kind === 'travelled' ? 'travel' : 'work';
const workCount = ALL_PLACES.filter(p => p.kind !== 'cluster' && p.kind !== 'travelled').length;
const travelCount = ALL_PLACES.filter(p => p.kind === 'travelled').length;
const placeCount = ALL_PLACES.filter((p) => p.kind !== 'cluster').length;
---

<section class="map-hero site-shell" id="atlas" aria-labelledby="map-hero-title">
  <div class="atlas-heading"><div><p class="section-kicker">An atlas of places & perspectives</p><h2 id="map-hero-title">Follow a place into the work.</h2></div><p>Where I’ve lived and worked, where I’ve traveled, and the places I’ve written about.</p></div>
  <div class="atlas-controls" aria-label="Atlas layers">
    <button type="button" data-layer="all" aria-pressed="true">All places</button>
    <button type="button" data-layer="work" aria-pressed="false"><i class="map-swatch map-swatch--worked" aria-hidden="true"></i>Lived / worked / studied in <span>{workCount}</span></button>
    <button type="button" data-layer="travel" aria-pressed="false"><i class="map-swatch map-swatch--travelled" aria-hidden="true"></i>Traveled to <span>{travelCount}</span></button>
    <button type="button" data-layer="paper" aria-pressed="false"><i class="map-swatch map-swatch--studies" aria-hidden="true"></i>Studied / wrote about <span>{MAPPED_PAPERS.length}</span></button>
  </div>

  <div class="chrono" id="atlas-chrono">
    <div class="chrono__rail-wrap">
      <ol class="chrono__rail" id="chrono-rail" style={`--count:${chapters.length}`}>
        {chapters.map((chapter, i) => (
          <li class="chrono__stop">
            <button
              type="button"
              class="chrono__stop-btn"
              data-step={i}
              data-chrono-place={chapter.place}
              aria-pressed="false"
            >
              <span class="chrono__dot" aria-hidden="true"></span>
              <span class="chrono__year">{chapter.year}</span>
              <span class="chrono__short">{chapter.short}</span>
            </button>
          </li>
        ))}
      </ol>
    </div>
    <div class="chrono__controls">
      <button type="button" class="chrono__step" data-dir="-1">‹ Later</button>
      <p class="chrono__position">Follow the work backwards through time</p>
      <button type="button" class="chrono__step" data-dir="1">Earlier ›</button>
    </div>
  </div>
  <div class="map-hero__rail">
    <nav class="place-index" aria-label="Places lived, worked, studied in, or traveled to">
      <div class="place-index__head">
        <h3>Places in my life</h3>
        <span class="place-index__count">{placeCount} places</span>
      </div>
      <ol class="place-index__list">
        {ALL_PLACES.filter(place => place.kind !== 'cluster').map(place => <li data-index-layer={layerFor(place.kind)}><button type="button" class="place-index__item" data-place={place.id} aria-pressed="false"><span class="place-index__place">{place.short}</span><span class="place-index__meta">{place.kind === 'travelled' ? 'Travel' : 'Lived / worked / studied in'}{place.period ? ` · ${place.period}` : ''}</span></button></li>)}
      </ol>
    </nav>

    <nav data-index-layer="paper" class="place-index place-index--papers" aria-label="Places the published work is set in">
      <div class="place-index__head">
        <h3>Places in my writing</h3>
        <span class="place-index__count">{MAPPED_PAPERS.length} papers</span>
      </div>
      <ol class="place-index__list">
        {MAPPED_PAPERS.map((paper) => (
          <li>
            <button type="button" class="place-index__item" data-place={`paper-${paper.id}`}>
              <span class="place-index__place">{paper.place}</span>
              <span class="place-index__meta">{paper.venue.split(':')[0]}, {paper.year}</span>
            </button>
          </li>
        ))}
      </ol>
    </nav>

    <div class="map-legend"><label class="map-legend__item map-legend__toggle"><input type="checkbox" id="map-studies-toggle" /> Also show project subjects</label></div>
    <div class="dossier" id="map-dossier" aria-live="polite" aria-atomic="true">
      <article class="dossier__panel" data-dossier="default"><p class="section-kicker">Choose a place</p><h3>Life, travel, and scholarship.</h3><p>Select a place to see its story and related work. A paper marker means I wrote about a place; it does not imply I visited.</p><p class="dossier__hint">{placeCount} lived/worked and travel records · {MAPPED_PAPERS.length} geographic papers</p><a class="resource-link" href={withBase('/writing')}>Browse all five papers →</a></article>

      {dossiers.map(({ place, prev, next, projects, coords }) => (
        <article class="dossier__panel" data-dossier={place.id} hidden>
          {place.media ? (
            <figure class="dossier__media">
              <img src={withBase(place.media.src)} alt={place.media.alt} loading="lazy" decoding="async" width="640" height="440" />
              {place.media.kind === 'video' && (
                <button type="button" class="play" data-video={place.media.youtubeId} data-title={place.media.caption}>
                  <span class="play__glyph" aria-hidden="true"></span>
                  <span class="play__label">Play video</span>
                </button>
              )}
              <figcaption>{place.media.caption}</figcaption>
            </figure>
          ) : null}
          <p class="section-kicker">
            {place.kind === 'cluster' ? 'Place group' : place.kind === 'travelled' ? 'Traveled to' : 'Lived / worked / studied in'}
            {place.institutions[0] ? ` · ${place.institutions[0]}` : ''}
          </p>
          <h3 tabindex="-1">{place.name}</h3>
          <p class="dossier__meta">
            {place.period && <span class="dossier__period">{place.period}</span>}
            <span class="dossier__coords">{coords}</span>
          </p>
          {place.roles.length > 0 && (
            <ul class="dossier__roles">{place.roles.map((role) => <li>{role}</li>)}</ul>
          )}
          <p>{place.context}</p>
          {place.source && <p><a class="resource-link" href={place.source.href}>{place.source.label} ↗</a></p>}
          {place.children && (
            <div class="dossier__sub">
              <h4>Inside {place.short}</h4>
              {place.children.map((child) => (
                <button type="button" class="dossier__chip" data-place={child.id}>{child.short}</button>
              ))}
            </div>
          )}
          {projects.length > 0 && (
            <div class="dossier__projects">
              <h4>Related work</h4>
              <ul>
                {projects.map((project) => (
                  <li>
                    <a href={withBase(project.href)} data-region={project.region}>{project.title}</a>
                    <span class:list={['tag', `tag--${project.relation}`]}>
                      {project.relation === 'made' ? 'Made here' : 'Studies this place'}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          <div class="dossier__nav">
            <button type="button" class="dossier__step" data-place={prev.id}>‹ {prev.short}</button>
            <button type="button" class="dossier__step" data-place={next.id}>{next.short} ›</button>
          </div>
        </article>
      ))}

      {PAPERS.filter((paper) => paper.region && paper.coords).map((paper) => (
        <article class="dossier__panel dossier__panel--paper" data-dossier={`paper-${paper.id}`} hidden>
          <p class="section-kicker">Published paper · {paper.place}</p>
          <h3 tabindex="-1">{paper.title}</h3>
          <p class="dossier__meta">
            <span class="dossier__period">{paper.venue}</span>
            <span class="dossier__coords">{[paper.volume, paper.pages, paper.year].filter(Boolean).join(' · ')}</span>
          </p>
          <p>{paper.summary}</p>{paper.region === 'us-west' && <p class="dossier__hint">The shaded American West is a schematic research area, not a precise survey boundary.</p>}
          <p><a class="resource-link" href={withBase(`/writing#${paper.id}`)}>Publication details & citation →</a></p>

          <p class="dossier__read">
            <a href={paper.url} target="_blank" rel="noreferrer">{paper.linkLabel} →</a>
          </p>
        </article>
      ))}
    </div>

    <div class="map-hero__actions">
      <a class="resource-link" href={withBase('/works#media')}>Photos & artifacts →</a>
      <a class="resource-link" href="#selected-work">Selected work ↓</a>
    </div>
  </div>

  <div class="map-plate" id="map-plate" data-studies="off">
    <div class="map-plate__stage" id="map-stage" style={`--vb-w:${W};--vb-h:${H}`}>
      <svg
        class="map-plate__svg"
        viewBox={`0 0 ${W} ${H}`}
        preserveAspectRatio="xMidYMid meet"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="World map with distinct lived/worked, travel, and scholarly-subject markers. Every record is also available in the adjacent place lists."
      >
        <defs>
          <pattern id="map-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="0" x2="0" y2="7" class="map-hatch__line" />
          </pattern>
        </defs>
        <rect class="map-water" width={W} height={H} />
        <path class="map-graticule" d={graticule} />
        <path class="map-land" d={land} />
        <path class="map-land" d={morocco} />
        <path class="map-borders" d={borders} />
        {studyRegions.map((region) => (
          <path
            class:list={['map-study', { 'map-study--paper': paperRegions.has(region.region) }]}
            data-region={region.region}
            d={region.d}
          />
        ))}
        <path class="map-journey" d={journey} />
      </svg>
      <div class="map-nodes" id="map-nodes" role="group" aria-label="Map locations. Arrow keys move between places, Enter opens one, Escape returns to the full map.">
        {paperNodes.map(({ paper, left, top }) => (
          <button
            type="button"
            class="map-node map-node--paper"
            data-layer-kind="paper"
            data-place={`paper-${paper.id}`}
            data-label={paper.labelPos ?? 'right'}
            style={`left:${left}%;top:${top}%;--dx:0%;--dy:0%`}
            aria-pressed="false"
            aria-label={`${paper.place} — published paper: ${paper.title}`}
          >
            <span class="map-node__pin">
              <span class="map-node__sheet" aria-hidden="true"></span>
              <span class="map-node__label">{paper.place}</span>
            </span>
          </button>
        ))}
        {nodes.map(({ place, parentId, left, top, zoom }) => (
          <button
            type="button"
            class:list={['map-node', `map-node--${place.kind}`, { 'map-node--child': parentId }]}
            data-place={place.id}
            data-parent={parentId}
            data-layer-kind={layerFor(place.kind)}
            data-label={place.labelPos}
            data-zoom={zoom ? `${zoom.k},${zoom.x},${zoom.y}` : undefined}
            style={`left:${left}%;top:${top}%;--dx:${(place.offset?.[0] ?? 0) / W * 100}%;--dy:${(place.offset?.[1] ?? 0) / H * 100}%`}
            aria-pressed="false"
            aria-label={
              place.kind === 'cluster'
                ? `${place.name} — ${place.children!.length} places. Opens a closer view.`
                : `${place.name}${place.institutions[0] ? ` — ${place.institutions[0]}` : ''}`
            }
            hidden={parentId ? true : undefined}
          >
            <span class="map-node__pin">
              <span class="map-node__dot"></span>
              <span class="map-node__label">
                {place.short}
                {place.kind === 'cluster' && <small> · {place.children!.length}</small>}
              </span>
            </span>
          </button>
        ))}
      </div>

      <!--
        Pinned evidence. Selecting a place lifts its photograph or film out of the
        pin on a hairline leader, then lets it breathe. Desktop only: on a phone
        the same media sits in the dossier, where there is room for it.
      -->
      <div class="pin-cards" id="pin-cards" aria-hidden="true">
        {nodes
          .filter(({ place }) => place.media)
          .map(({ place, left, top, cardSide }) => (
            <div
              class:list={['pin-card', `pin-card--${cardSide}`]}
              data-card={place.id}
              style={`left:${left}%;top:${top}%`}
              hidden
            >
              <span class="pin-card__leader" aria-hidden="true"></span>
              <figure class="pin-card__body">
                <div class="pin-card__frame">
                  <img src={withBase(place.media!.src)} alt={place.media!.alt} loading="lazy" decoding="async" />
                  {place.media!.kind === 'video' && (
                    <button type="button" class="play play--pin" data-video={place.media!.youtubeId} data-title={place.media!.caption}>
                      <span class="play__glyph" aria-hidden="true"></span>
                      <span class="play__label">Play</span>
                    </button>
                  )}
                </div>
                <figcaption>
                  <span class="pin-card__place">{place.short}</span>
                  <span class="pin-card__caption">{place.media!.caption}</span>
                </figcaption>
              </figure>
            </div>
          ))}
      </div>
    </div>
    <p class="map-plate__caption" aria-hidden="true">Plate I · Life, travel & scholarship · Equal Earth projection</p>
    <button type="button" class="map-plate__reset" id="map-reset" hidden>← Full map</button>
  </div>
</section>

<script>
 function setupAtlas() {
  const plate = document.getElementById('map-plate');
  const stage = document.getElementById('map-stage');
  const nodeLayer = document.getElementById('map-nodes');
  const dossier = document.getElementById('map-dossier');
  const reset = document.getElementById('map-reset');
  const toggle = document.getElementById('map-studies-toggle') as HTMLInputElement | null;
  const cardLayer = document.getElementById('pin-cards');
  const hero = document.querySelector<HTMLElement>('.map-hero');

  if (plate && stage && nodeLayer && dossier && reset && hero && !hero.dataset.wired) {
    hero.dataset.wired = 'true';
    const layerButtons = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-layer]'));
    let layer = 'all';
    const writeState = () => {
      const url = new URL(location.href);
      if (selected) url.searchParams.set('place', selected); else url.searchParams.delete('place');
      if (layer !== 'all') url.searchParams.set('layer', layer); else url.searchParams.delete('layer');
      history.replaceState(history.state, '', url);
    };
    const nodes = Array.from(nodeLayer.querySelectorAll<HTMLButtonElement>('.map-node'));
    const indexItems = Array.from(document.querySelectorAll<HTMLButtonElement>('.place-index__item'));
    const panels = Array.from(dossier.querySelectorAll<HTMLElement>('.dossier__panel'));
    const cards = Array.from(cardLayer?.querySelectorAll<HTMLElement>('.pin-card') ?? []);

    /** Tear down any playing embed so a hidden card can never keep making sound. */
    const stopMedia = (scope: HTMLElement) => {
      for (const frame of scope.querySelectorAll('iframe')) frame.remove();
      for (const el of scope.querySelectorAll('.is-playing')) el.classList.remove('is-playing');
    };
    const isMobile = () => window.matchMedia('(max-width: 900px)').matches;
    const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

    let selected: string | null = null;
    let expanded: string | null = null;

    // ── Chronology rail ──────────────────────────────────────────────────────
    // The rail is a second way into the same map: each stop is a chapter, and
    // choosing one flies the plate to the place that chapter happened in. It
    // reads newest-first, so stepping "Earlier" walks backwards through time.
    const chronoRail = document.getElementById('chrono-rail');
    const chronoStops = Array.from(
      hero.querySelectorAll<HTMLButtonElement>('.chrono__stop-btn')
    );
    const chronoSteppers = Array.from(hero.querySelectorAll<HTMLButtonElement>('.chrono__step'));
    const lastStop = chronoStops.length - 1;
    let step = -1;

    const syncChrono = () => {
      // A place can belong to several chapters (three of them are Raleigh), so
      // the active stop is whichever one the visitor last moved to — fall back to
      // the first stop matching the selection when the map was driven directly.
      if (step < 0 || chronoStops[step]?.dataset.chronoPlace !== selected) {
        step = selected
          ? chronoStops.findIndex((s) => s.dataset.chronoPlace === selected)
          : -1;
      }
      chronoStops.forEach((stop, i) => {
        const on = i === step;
        stop.setAttribute('aria-pressed', String(on));
        stop.classList.toggle('is-active', on);
      });
      chronoRail?.style.setProperty('--fill', String(step > 0 && lastStop > 0 ? step / lastStop : 0));
      chronoRail?.toggleAttribute('data-none', step < 0);
      for (const stepper of chronoSteppers) {
        const dir = Number(stepper.dataset.dir);
        stepper.disabled = step < 0 ? false : dir < 0 ? step === 0 : step === lastStop;
      }
    };

    const goToStop = (next: number) => {
      const target = Math.min(lastStop, Math.max(0, next));
      const place = chronoStops[target]?.dataset.chronoPlace;
      if (!place) return;
      step = target;
      select(place);
      chronoStops[target].scrollIntoView({ inline: 'center', block: 'nearest', behavior: smooth });
    };

    chronoStops.forEach((stop, i) => stop.addEventListener('click', () => goToStop(i)));
    for (const stepper of chronoSteppers) {
      stepper.addEventListener('click', () =>
        goToStop(step < 0 ? (Number(stepper.dataset.dir) < 0 ? lastStop : 0) : step + Number(stepper.dataset.dir))
      );
    }
    chronoRail?.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (!['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Home', 'End'].includes(key)) return;
      event.preventDefault();
      const target =
        key === 'Home' ? 0
        : key === 'End' ? lastStop
        : Math.max(0, step) + (key === 'ArrowRight' || key === 'ArrowDown' ? 1 : -1);
      goToStop(target);
      chronoStops[Math.min(lastStop, Math.max(0, target))]?.focus({ preventScroll: true });
    });

    const applyZoom = () => {
      const cluster = expanded ? nodes.find((n) => n.dataset.place === expanded) : null;
      const zoom = cluster?.dataset.zoom;
      if (zoom) {
        const [k, x, y] = zoom.split(',').map(Number);
        stage.style.setProperty('--k', String(k));
        stage.style.transform = `translate(${(x / Number(stage.style.getPropertyValue('--vb-w'))) * 100}%, ${(y / Number(stage.style.getPropertyValue('--vb-h'))) * 100}%) scale(${k})`;
      } else {
        stage.style.setProperty('--k', '1');
        stage.style.transform = '';
      }
      reset.hidden = !expanded;
    };

    const sync = () => {
      hero.dataset.layer = layer;
      layerButtons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.layer === layer)));
      hero.querySelectorAll<HTMLElement>('[data-index-layer]').forEach(item => { item.hidden = layer !== 'all' && item.dataset.indexLayer !== layer; });
      for (const node of nodes) {
        const id = node.dataset.place!;
        const parent = node.dataset.parent;
        const isCluster = node.classList.contains('map-node--cluster');
        // While a cluster is open the plate is zoomed into it, so anything outside
        // that cluster is off-screen — hide it rather than leave it in the tab order.
        node.hidden = (isCluster ? expanded === id || layer === 'paper' : parent ? expanded !== parent : Boolean(expanded)) || (!isCluster && layer !== 'all' && node.dataset.layerKind !== layer);
        node.setAttribute('aria-pressed', String(selected === id));
      }
      for (const item of indexItems) {
        const on = item.dataset.place === selected;
        item.toggleAttribute('aria-current', on);
        item.setAttribute('aria-pressed', String(on));
        if (on && isMobile()) item.scrollIntoView({ inline: 'center', block: 'nearest', behavior: smooth });
      }
      for (const panel of panels) {
        const on = panel.dataset.dossier === (selected ?? 'default');
        if (!on) stopMedia(panel);
        panel.hidden = !on;
      }
      syncChrono();
      // The pinned card is hidden with [hidden], so display:none → block restarts
      // its rise animation each time a place is selected. No manual reset needed.
      for (const card of cards) {
        const on = card.dataset.card === selected;
        if (!on) stopMedia(card);
        card.hidden = !on;
      }
      applyZoom();
    };

    const select = (id: string, focusNode = false, announce = true) => {
      const node = nodes.find((n) => n.dataset.place === id);
      if (!node) return;
      if (layer !== 'all' && node.dataset.layerKind !== layer) layer = 'all';
      selected = id;
      expanded = node.classList.contains('map-node--cluster') ? id : node.dataset.parent || null;
      sync();
      if (announce) writeState();
      if (!announce) return;
      if (focusNode) node.focus({ preventScroll: true });
      const heading = panels.find((p) => p.dataset.dossier === id)?.querySelector('h3');
      if (!focusNode) heading?.focus?.({ preventScroll: true });
      // The rail scrolls, so a selection made low in the index could otherwise
      // update a dossier the visitor cannot see. Bring it into view on every width.
      dossier.scrollIntoView({ block: 'nearest', behavior: smooth });
    };

    const clear = () => {
      selected = null;
      expanded = null;
      sync();
      writeState();
    };

    layerButtons.forEach(button => button.addEventListener('click', () => {
      layer = button.dataset.layer!; selected = null; expanded = layer === 'travel' ? 'morocco' : null; sync(); writeState();
    }));

    hero.addEventListener('click', (event) => {
      const play = (event.target as HTMLElement).closest<HTMLButtonElement>('.play');
      if (play) {
        event.preventDefault();
        const frame = play.parentElement!;
        const embed = document.createElement('iframe');
        embed.src = `https://www.youtube-nocookie.com/embed/${play.dataset.video}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
        embed.title = play.dataset.title ?? 'Video';
        embed.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        embed.allowFullscreen = true;
        frame.classList.add('is-playing');
        frame.append(embed);
        return;
      }
      const target = (event.target as HTMLElement).closest<HTMLElement>('[data-place]');
      if (!target) return;
      select(target.dataset.place!, target.classList.contains('map-node'));
    });

    reset.addEventListener('click', () => {
      const previous = expanded ?? selected;
      clear();
      if (previous) nodes.find((n) => n.dataset.place === previous)?.focus();
    });

    toggle?.addEventListener('change', () => {
      plate.dataset.studies = toggle.checked ? 'on' : 'off';
    });

    // A related-work link reveals the region that project studies.
    const setRegion = (region?: string) => {
      if (region) plate.dataset.regionActive = region;
      else delete plate.dataset.regionActive;
    };
    for (const [on, off] of [['mouseover', 'mouseout'], ['focusin', 'focusout']] as const) {
      dossier.addEventListener(on, (event) => {
        setRegion((event.target as HTMLElement).closest<HTMLElement>('[data-region]')?.dataset.region);
      });
      dossier.addEventListener(off, () => setRegion());
    }

    nodeLayer.addEventListener('keydown', (event) => {
      const visible = nodes.filter((n) => !n.hidden);
      const index = visible.indexOf(document.activeElement as HTMLButtonElement);
      const go = (next: number) => visible[(next + visible.length) % visible.length]?.focus();
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') { event.preventDefault(); go(index + 1); }
      else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') { event.preventDefault(); go(index - 1); }
      else if (event.key === 'Home') { event.preventDefault(); go(0); }
      else if (event.key === 'End') { event.preventDefault(); go(visible.length - 1); }
    });

    hero.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key !== 'Escape' || (!expanded && !selected)) return;
      const previous = expanded ?? selected;
      clear();
      if (previous) nodes.find((n) => n.dataset.place === previous)?.focus();
    });

    // A missing photograph degrades into the designed placeholder rather than a broken image.
    dossier.addEventListener(
      'error',
      (event) => {
        const image = event.target as HTMLElement;
        if (image.tagName !== 'IMG') return;
        const figure = image.closest('figure');
        if (!figure) return;
        figure.hidden = true;
      },
      true
    );

    const restore = () => {
      const params = new URLSearchParams(location.search);
      layer = ['work','travel','paper'].includes(params.get('layer') ?? '') ? params.get('layer')! : 'all';
      selected = null; expanded = layer === 'travel' ? 'morocco' : null;
      const place = params.get('place');
      if (place && nodes.some(n => n.dataset.place === place)) select(place, false, false); else sync();
    };
    const controller = new AbortController();
    window.addEventListener('popstate', restore, { signal: controller.signal });
    document.addEventListener('astro:before-swap', () => { controller.abort(); panels.forEach(stopMedia); cards.forEach(stopMedia); }, { once: true });
    restore();
  }
 }
 document.addEventListener('astro:page-load', setupAtlas);
 setupAtlas();
</script>
