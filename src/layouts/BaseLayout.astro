---
import { ClientRouter } from 'astro:transitions';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import { siteMeta } from '../data/site';
import { withBase } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = siteMeta.title,
  description = siteMeta.description,
  image = '/assets/fieldwork/og/og-home.jpg'
} = Astro.props;

const pageTitle = title === siteMeta.title ? title : `${title} | Reese Hollister`;
const siteUrl = Astro.site ?? new URL('https://reesehollister.com');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = new URL(withBase(image), siteUrl).toString();
const faviconHref = withBase('/assets/ui/favicon.svg');
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-V4RR8JGB9W"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-V4RR8JGB9W');
    </script>
    <!-- Google AdSense -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6836886591845444" crossorigin="anonymous"></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Reese W. Hollister" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/assets/ui/apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Reese W. Hollister',
      url: siteUrl.toString(),
      image: new URL(withBase('/assets/fieldwork/og/og-home.jpg'), siteUrl).toString(),
      jobTitle: 'Researcher, Educator, and Writing Consultant',
      description: siteMeta.description,
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'North Carolina State University' },
        { '@type': 'CollegeOrUniversity', name: 'Manhattan College' }
      ],
      award: [
        'Fulbright Scholar – Morocco 2023–24',
        'VenturePack Winner – NC State 2026'
      ],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', name: 'CRLA Level III Writing Consultant' },
        { '@type': 'EducationalOccupationalCredential', name: 'Fulbright Scholar, U.S. Department of State' },
        { '@type': 'EducationalOccupationalCredential', name: 'Master of International Studies, NC State University' }
      ],
      knowsLanguage: ['English', 'Arabic', 'French'],
      knowsAbout: ['North African history', 'Morocco', 'Western Sahara', 'Postcolonial institutions', 'Arabic language education', 'Academic writing', 'Fulbright Program', 'Digital history', 'Public history'],
      sameAs: [
        'https://ncsu.academia.edu/ReeseHollister',
        'https://www.youtube.com/channel/UCCRhHuIxYd3wyzYuaCNH3AA/',
        'https://github.com/Reesewhollister',
        'https://www.linkedin.com/in/reese-h-13b09519a/',
        'https://reesewhollister.substack.com'
      ]
    })} />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
    <script>
      // Global delegated analytics handler. Picks up data-track / data-track-label
      // on any element and fires gtag safely. Re-wired on each Astro page transition.
      let _trackHandler: ((e: MouseEvent) => void) | null = null;
      function setupTracking() {
        if (_trackHandler) document.removeEventListener('click', _trackHandler as EventListener);
        _trackHandler = (e: MouseEvent) => {
          const el = (e.target as Element).closest('[data-track]');
          if (!el) return;
          const eventName = el.getAttribute('data-track');
          const label = el.getAttribute('data-track-label') ?? undefined;
          if (eventName && typeof window.gtag === 'function') {
            window.gtag('event', eventName, label ? { event_label: label } : {});
          }
        };
        document.addEventListener('click', _trackHandler as EventListener);
      }
      document.addEventListener('astro:page-load', setupTracking);
    </script>
    <script>
      // Scroll-reveal for sections. Safe by design: content is only hidden
      // once JS has run and the user has not requested reduced motion.
      function setupReveals() {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const sections = Array.from(document.querySelectorAll('main > section, .project-page > section'));
        if (prefersReduced || !('IntersectionObserver' in window)) {
          sections.forEach((s) => s.classList.add('is-visible'));
          return;
        }
        document.documentElement.classList.add('reveal-ready');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
        );
        sections.forEach((section) => {
          // Never hide hero sections — they have their own entrance animations.
          if (
            section.classList.contains('cinematic-hero') ||
            section.classList.contains('map-hero') ||
            section.classList.contains('page-hero') ||
            section.classList.contains('project-hero')
          ) {
            section.classList.add('is-visible');
            return;
          }
          section.classList.add('reveal');
          io.observe(section);
        });
      }
      document.addEventListener('astro:page-load', setupReveals);
    </script>
    <script>
      // Motion library (Asset & Motion System). Freeze-safe: resting states are
      // already final in the HTML/CSS; we only layer motion on once JS confirms
      // motion is allowed (html.motion-ready) and elements enter view.
      function setupMotion() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) return;
        document.documentElement.classList.add('motion-ready');

        // Kinetic headlines: drive each line with an inline keyframe (staggered).
        // Freeze-safe: the entrance is one-shot and cleared on end (or via a
        // wall-clock fallback), so a frozen animation frame still settles VISIBLE
        // at the resting state rather than stuck on the hidden `from` keyframe.
        const playKinetic = (el: Element) => {
          el.querySelectorAll('.kinetic__line').forEach((node, i) => {
            const line = node as HTMLElement;
            const delay = i * 120;
            line.style.animation = 'none';
            void line.offsetWidth; // reflow so a replay restarts cleanly
            line.style.animation = 'rdClipUp 0.8s cubic-bezier(0.22,0.61,0.36,1) ' + delay + 'ms both';
            const clear = () => { line.style.animation = 'none'; };
            line.addEventListener('animationend', clear, { once: true });
            setTimeout(clear, delay + 1100); // fallback: settle visible if the clock stalls
          });
        };

        // Image wipe: arm hidden, reveal on view. Freeze-safe — a fallback forces
        // the photo fully visible if the transition clock stalls.
        const revealWipe = (el: Element) => {
          el.classList.add('play');
          const done = () => { el.classList.remove('is-armed'); (el as HTMLElement).style.clipPath = 'inset(0 0 0 0)'; };
          el.addEventListener('transitionend', done, { once: true });
          setTimeout(done, 1600);
        };
        document.querySelectorAll('.wipe').forEach((el) => el.classList.add('is-armed'));

        const countUp = (el: Element) => {
          const target = parseInt(el.getAttribute('data-count') || '', 10);
          if (isNaN(target)) return;
          const comma = el.hasAttribute('data-count-comma');
          const dur = 1400;
          const start = performance.now();
          const fmt = (v: number) => (comma ? v.toLocaleString('en-US') : String(v));
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / dur);
            const eased = 1 - Math.pow(1 - t, 3);
            el.textContent = fmt(Math.round(target * eased));
            if (t < 1) requestAnimationFrame(tick);
            else el.textContent = fmt(target);
          };
          requestAnimationFrame(tick);
        };

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const t = entry.target;
              if (t.classList.contains('kinetic')) playKinetic(t);
              if (t.classList.contains('wipe')) revealWipe(t);
              if (t.hasAttribute('data-count')) countUp(t);
              io.unobserve(t);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.2 }
        );
        // Above-the-fold hero headlines play immediately; everything else on view.
        const heroKinetics = new Set(
          document.querySelectorAll('.home-hero .kinetic, .project-hero .kinetic, .page-hero .kinetic')
        );
        document.querySelectorAll('.kinetic, .wipe, [data-count]').forEach((el) => {
          if (heroKinetics.has(el)) return;
          io.observe(el);
        });
        heroKinetics.forEach((el) => playKinetic(el));
      }
      document.addEventListener('astro:page-load', setupMotion);
    </script>
  </body>
</html>
